
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 160" width="540" height="160">
  <!-- Clean white background -->
  <rect width="540" height="160" fill="#ffffff"/>

  <!-- ==================== WORDMARK ==================== -->
  
  <!-- "ask" in Georgia serif -->
  <text x="50" y="102" 
        font-family="Georgia, serif" 
        font-size="64" 
        fill="#0a0e1a" 
        font-weight="400">ask</text>

  <!-- Opening brace { in Swagger green -->
  <text x="170" y="102" 
        font-family="'SF Mono', 'Menlo', monospace" 
        font-size="64" 
        fill="#85EA2D" 
        font-weight="700">{</text>

  <!-- ===== The "A" as GraphQL triangle ===== -->
  <!-- Sized to match cap height of surrounding mono letters -->
  <g transform="translate(240, 58)">
    <!-- Outer triangle = the letter A -->
    <polygon points="0,-16 26,42 -26,42" 
             fill="none" 
             stroke="#E10098" 
             stroke-width="5.5"
             stroke-linejoin="round"/>
    <!-- Horizontal crossbar = both the A's crossbar AND a GraphQL internal line -->
    <line x1="-14" y1="20" x2="14" y2="20" 
          stroke="#E10098" 
          stroke-width="5.5"
          stroke-linecap="round"/>
    <!-- 3 corner dots = GraphQL vertices -->
    <circle cx="0" cy="-16" r="5.5" fill="#E10098"/>
    <circle cx="26" cy="42" r="5.5" fill="#E10098"/>
    <circle cx="-26" cy="42" r="5.5" fill="#E10098"/>
  </g>

  <!-- "PI" in bold mono -->
  <text x="274" y="102" 
        font-family="'SF Mono', 'Menlo', monospace" 
        font-size="60" 
        fill="#0a0e1a" 
        font-weight="700"
        letter-spacing="-1">PI</text>

  <!-- Closing brace } in Swagger green -->
  <text x="346" y="102" 
        font-family="'SF Mono', 'Menlo', monospace" 
        font-size="64" 
        fill="#85EA2D" 
        font-weight="700">}</text>

  <!-- Minimal tagline -->
  <text x="50" y="130" 
        font-family="'SF Mono', 'Menlo', monospace" 
        font-size="11" 
        fill="#9ca3af" 
        letter-spacing="1">ask·any·API</text>
</svg>
